{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sneh30.github.io/portfolio/schemas/capabilities.schema.json",
  "title": "capabilities.json — capability → evidence map",
  "description": "Schema for /portfolio/capabilities.json. Each capability carries evidence entries whose verification uses the shared status/checked vocabulary.",
  "type": "object",
  "required": ["schema_version", "generated_at", "candidate", "schema", "note",
               "capabilities", "explicit_non_claims", "evidence_labels"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "generated_at": {"$ref": "#/$defs/date"},
    "candidate": {"type": "string"},
    "schema": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "note": {"type": "string"},
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "claim", "strength", "skills_used",
                     "evidence", "related_experience"],
        "properties": {
          "id": {"type": "string", "pattern": "^capability-[a-z0-9-]+$"},
          "name": {"type": "string"},
          "claim": {"type": "string"},
          "strength": {"enum": ["primary", "supported"]},
          "skills_used": {"type": "array", "items": {"type": "string"}},
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {"$ref": "#/$defs/evidence_entry"}
          },
          "related_experience": {
            "type": "array",
            "items": {"type": "string", "pattern": "^experience-[a-z0-9-]+$"}
          }
        },
        "additionalProperties": true
      }
    },
    "explicit_non_claims": {
      "type": "array", "minItems": 1,
      "items": {"type": "string"}
    },
    "evidence_labels": {
      "type": "object",
      "required": ["note", "values", "definitions"],
      "properties": {
        "note": {"type": "string"},
        "values": {
          "const": ["public_repo", "private_available_on_request",
                    "external_validation", "documented_experience",
                    "self_reported", "experimental"]
        },
        "definitions": {
          "type": "object",
          "required": ["public_repo", "private_available_on_request",
                       "external_validation", "documented_experience",
                       "self_reported", "experimental"],
          "additionalProperties": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "label": {
      "enum": ["public_repo", "private_available_on_request",
               "external_validation", "documented_experience",
               "self_reported", "experimental"]
    },
    "evidence_entry": {
      "type": "object",
      "required": ["implementation", "result", "status", "checked"],
      "properties": {
        "project": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^project-[a-z0-9-]+$"}
          ]
        },
        "implementation": {"type": "string"},
        "result": {"type": "string"},
        "verification_url": {"type": "string", "format": "uri"},
        "status": {"$ref": "#/$defs/label"},
        "qualifiers": {
          "type": "array", "items": {"$ref": "#/$defs/label"}
        },
        "checked": {"$ref": "#/$defs/date"},
        "note": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
