{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sneh30.github.io/portfolio/schemas/agent-card.schema.json",
  "title": "agent-card.json — agent-facing surface description",
  "description": "Schema for /portfolio/agent-card.json. target_roles must project exactly onto candidate.json#roles; job_search must be identical to candidate.json's.",
  "type": "object",
  "required": ["schema_version", "generated_at", "kind", "schema",
               "canonical_url", "candidate", "purpose",
               "machine_readable_files", "core_capabilities",
               "flagship_evidence", "external_validation", "experience",
               "target_roles", "job_search", "project_links",
               "evidence_labels", "support_levels", "limitations"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "generated_at": {"$ref": "#/$defs/date"},
    "kind": {"const": "portfolio-agent-surface-description"},
    "canonical_url": {"const": "https://sneh30.github.io/portfolio/"},
    "schema": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "candidate": {
      "type": "object",
      "required": ["name", "role"],
      "properties": {
        "name": {"type": "string"},
        "role": {"type": "string"}
      },
      "additionalProperties": true
    },
    "purpose": {"type": "string"},
    "machine_readable_files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "format", "content"],
        "properties": {
          "path": {"type": "string"},
          "format": {"type": "string"},
          "content": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "core_capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability", "evidence"],
        "properties": {
          "capability": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "flagship_evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["project", "status", "link"],
        "properties": {
          "project": {"type": "string"},
          "status": {"$ref": "#/$defs/label"},
          "link": {"type": "string", "format": "uri"}
        },
        "additionalProperties": true
      }
    },
    "external_validation": {
      "type": "object",
      "required": ["pull_request", "upstream_repository", "merged",
                   "commits", "tests_added", "commands_fixed",
                   "upstream_stars", "stars_checked", "verification"],
      "properties": {
        "pull_request": {"type": "string", "format": "uri"},
        "upstream_repository": {"type": "string", "format": "uri"},
        "merged": {"$ref": "#/$defs/date"},
        "commits": {"type": "integer"},
        "tests_added": {"type": "integer"},
        "commands_fixed": {"type": "string"},
        "upstream_stars": {"type": "integer"},
        "stars_checked": {"$ref": "#/$defs/date"},
        "verification": {
          "type": "object",
          "required": ["method", "checked"],
          "properties": {
            "method": {"type": "string"},
            "checked": {"$ref": "#/$defs/date"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "experience": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "period", "evidence_summary", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^experience-[a-z0-9-]+$"},
          "title": {"type": "string"},
          "period": {"type": "string"},
          "evidence_summary": {"type": "string"},
          "status": {"$ref": "#/$defs/label"},
          "qualifiers": {
            "type": "array", "items": {"$ref": "#/$defs/label"}
          }
        },
        "additionalProperties": true
      }
    },
    "target_roles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "support"],
        "properties": {
          "id": {"type": "string", "pattern": "^role-[a-z0-9-]+$"},
          "role": {"type": "string"},
          "support": {"enum": ["strongly_supported", "supported",
                               "partially_supported"]},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "basis": {"$ref": "#/$defs/basis"},
          "evidence": {
            "type": "array",
            "items": {"type": "string", "pattern": "^capability-[a-z0-9-]+$"}
          },
          "projects": {
            "type": "array",
            "items": {"type": "string", "pattern": "^project-[a-z0-9-]+$"}
          },
          "experience": {
            "type": "array",
            "items": {"type": "string", "pattern": "^experience-[a-z0-9-]+$"}
          }
        },
        "additionalProperties": true
      }
    },
    "job_search": {"$ref": "#/$defs/job_search"},
    "project_links": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url", "status", "access"],
        "properties": {
          "name": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "status": {"$ref": "#/$defs/label"},
          "access": {"enum": ["public", "available_on_request"]}
        },
        "additionalProperties": true
      }
    },
    "evidence_labels": {
      "type": "object",
      "required": ["note", "values", "definitions"],
      "properties": {
        "note": {"type": "string"},
        "values": {
          "const": ["public_repo", "private_available_on_request",
                    "external_validation", "documented_experience",
                    "self_reported", "experimental"]
        },
        "definitions": {
          "type": "object",
          "required": ["public_repo", "private_available_on_request",
                       "external_validation", "documented_experience",
                       "self_reported", "experimental"],
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "support_levels": {
      "type": "object",
      "required": ["note", "values", "definitions"],
      "properties": {
        "note": {"type": "string"},
        "values": {
          "const": ["strongly_supported", "supported", "partially_supported"]
        },
        "definitions": {
          "type": "object",
          "required": ["strongly_supported", "supported",
                       "partially_supported"],
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "label": {
      "enum": ["public_repo", "private_available_on_request",
               "external_validation", "documented_experience",
               "self_reported", "experimental"]
    },
    "basis": {
      "description": "Typed support basis: a list of evidence kinds and/or a prose note. Never a free-form code string.",
      "anyOf": [
        {
          "type": "object",
          "required": ["kinds"],
          "properties": {
            "kinds": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"enum": ["project", "engagement"]}
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["note"],
          "properties": {"note": {"type": "string"}},
          "additionalProperties": false
        }
      ]
    },
    "job_search": {
      "type": "object",
      "required": ["open_to_work", "source", "engagement_types", "levels",
                   "roles_ref", "note"],
      "properties": {
        "open_to_work": {"const": true},
        "source": {"type": "string"},
        "engagement_types": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["internship", "full_time"]}
        },
        "levels": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["intern", "entry_level"]}
        },
        "roles_ref": {"const": "candidate.json#/roles"},
        "note": {"type": "string"}
      }
    }
  }
}
