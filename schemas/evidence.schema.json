{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sneh30.github.io/portfolio/schemas/evidence.schema.json",
  "title": "evidence.json — claim → evidence chains",
  "description": "Schema for /portfolio/evidence.json. Every chain walks claim → capability/experience → implementation → result → verification. evidence_label is a display label; typed refs are capability/project.",
  "type": "object",
  "required": ["schema_version", "generated_at", "candidate", "schema",
               "description", "evidence_labels", "chains", "external_sources"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "generated_at": {"$ref": "#/$defs/date"},
    "candidate": {"type": "string"},
    "schema": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "description": {"type": "string"},
    "evidence_labels": {
      "type": "object",
      "required": ["note", "values", "definitions"],
      "properties": {
        "note": {"type": "string"},
        "values": {
          "const": ["public_repo", "private_available_on_request",
                    "external_validation", "documented_experience",
                    "self_reported", "experimental"]
        },
        "definitions": {
          "type": "object",
          "required": ["public_repo", "private_available_on_request",
                       "external_validation", "documented_experience",
                       "self_reported", "experimental"],
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "chains": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "capability", "capability_name", "project",
                     "project_name", "implementation", "result",
                     "evidence_label", "verification"],
        "properties": {
          "claim": {"type": "string"},
          "capability": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^capability-[a-z0-9-]+$"}
            ]
          },
          "capability_name": {"type": "string"},
          "project": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^project-[a-z0-9-]+$"}
            ]
          },
          "project_name": {"type": "string"},
          "implementation": {"type": "string"},
          "result": {"type": "string"},
          "evidence_label": {"type": "string"},
          "verification": {"$ref": "#/$defs/verification"}
        },
        "additionalProperties": true
      }
    },
    "external_sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url", "checked", "facts"],
        "properties": {
          "name": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "checked": {"$ref": "#/$defs/date"},
          "facts": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "label": {
      "enum": ["public_repo", "private_available_on_request",
               "external_validation", "documented_experience",
               "self_reported", "experimental"]
    },
    "verification": {
      "type": "object",
      "required": ["status", "checked"],
      "properties": {
        "status": {"$ref": "#/$defs/label"},
        "qualifiers": {
          "type": "array", "items": {"$ref": "#/$defs/label"}
        },
        "checked": {"$ref": "#/$defs/date"},
        "source": {"type": "string"},
        "note": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
